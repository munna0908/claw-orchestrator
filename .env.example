# Plugin Configuration
PLUGIN_NAME=participant-orchestrator
PLUGIN_ENV=development

# Logging
LOG_LEVEL=debug

# OpenClaw Connection
OPENCLAW_HOST=localhost
OPENCLAW_PORT=8080

# Feature Flags
ENABLE_TELEGRAM=true
ENABLE_WHATSAPP=false

