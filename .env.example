# Plugin Configuration
PLUGIN_NAME=participant-orchestrator
PLUGIN_ENV=development

# Logging
LOG_LEVEL=debug

# OpenClaw Connection
OPENCLAW_HOST=localhost
OPENCLAW_PORT=8080

# Feature Flags
ENABLE_TELEGRAM=true
ENABLE_WHATSAPP=false

# External Service Endpoints
# INTELLIGENCE_SERVICE_URL=http://localhost:3001
# INFERENCE_SERVICE_URL=http://localhost:3002
# DELIVERY_SERVICE_URL=http://localhost:3003

# Restaurant Selector — Claude is primary, Gemini is fallback
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...._BX..
RESTAURANT_DATA_URL=https://your-gateway.mypinata.cloud/ipfs/<CID>
# ANTHROPIC_MODEL=claude-sonnet-4-6   # optional, defaults to claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.5-flash       # optional, defaults to gemini-2.0-flash
