{
  "name": "@openclaw/participant-orchestrator",
  "version": "0.1.0",
  "description": "OpenClaw plugin for participant-centric food-ordering workflow orchestration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openclaw": {
      "types": "./dist/openclaw-integration.d.ts",
      "import": "./dist/openclaw-integration.js"
    }
  },
  "openclaw": {
    "plugin": true,
    "main": "./dist/openclaw-integration.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "orchestrator",
    "telegram",
    "whatsapp"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "dotenv": "^16.3.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
